{
  "name": "wtc4d-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run make-mock-scene",
    "dev": "vite",
    "prebuild": "npm run make-mock-scene",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "make-mock-scene": "tsx scripts/make-mock-scene.ts"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.2.0",
    "leaflet": "^1.9.4",
    "three": "^0.186.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
